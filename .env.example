# Copy to .env (gitignored) and fill in real values. docker-compose reads .env automatically.

# ───────────────────────────────────────────────────────────────────────────────
# Core - Jarvis VPS integration
# ───────────────────────────────────────────────────────────────────────────────

# Where to fetch + write back delegated tasks. Public Jarvis URL.
JARVIS_BASE=https://jarvis.codedvisiondesign.co.uk

# Bearer token Jarvis accepts for the narrow scope: tasks where
# metadata.delegated_to = "local-code-agent". Generate fresh and paste the same
# value into the Jarvis repo .env (JARVIS_LOCAL_AGENT_TOKEN) so both sides match.
JARVIS_LOCAL_AGENT_TOKEN=

# Anthropic API key for Claude Code headless when backend=claude or smart.
ANTHROPIC_API_KEY=

# Webhook URL for posting completion summaries as "Jarvis" into the
# #📋-jarvis-tasks channel.
DISCORD_JARVIS_TASKS_WEBHOOK_URL=

# Polling cadence.
POLL_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=30

# Phase 22 — WebSocket gateway for cloud->agent task push. When
# enabled, the agent opens a persistent WS to JARVIS_WS_URL and
# triggers an immediate claim on every `new_task` push, cutting
# pickup from ~5 s to ~50 ms. The poll loop stays alive as a
# reconnect / cold-start fallback with cadence raised to
# WS_FALLBACK_POLL_SECONDS once the WS is connected.
JARVIS_WS_URL=wss://jarvis-ws.codedvisiondesign.co.uk/agent
JARVIS_WS_ENABLED=true
WS_FALLBACK_POLL_SECONDS=30

# ───────────────────────────────────────────────────────────────────────────────
# Local model backends
# ───────────────────────────────────────────────────────────────────────────────

# vLLM (Qwen2.5-Coder-14B-Instruct-AWQ) - points at the IDLE PROXY on the host, not the real vLLM.
# Proxy on :18000 forwards to real vLLM on :18001 and manages cold/warm cycles.
VLLM_BASE=http://host.docker.internal:18000
VLLM_MODEL=Qwen/Qwen2.5-Coder-14B-Instruct-AWQ

# Hermes (creative / planning tasks). Optional second vLLM instance on :18002.
# If unreachable, SmartBackend falls back to Qwen automatically.
HERMES_BASE=http://host.docker.internal:18002
HERMES_MODEL=NousResearch/Hermes-3-Llama-3.1-8B

# Tier 4 last-resort safety net (Cline Free proxy).
# Sign in at cline.bot, copy the account API key here.
# When tiers 1-3 (Claude / Qwen) all fail, the router falls through to this.
CLINE_API_KEY=
CLINE_API_BASE=https://api.cline.bot/v1
CLINE_MODEL=

# ───────────────────────────────────────────────────────────────────────────────
# GitHub - private repo creation, gh CLI, health loop
# ───────────────────────────────────────────────────────────────────────────────

# Personal access token. For full Jarvis features (private repo creation +
# enrolling repos in org deploy secrets) the token needs:
#   - repo (full control of private repos)
#   - admin:org (manage org secrets — for visibility=selected enrolment)
GITHUB_TOKEN=

# ───────────────────────────────────────────────────────────────────────────────
# Proactive health loop
# ───────────────────────────────────────────────────────────────────────────────

# Turn on the scheduled background scan that creates pending approvals for:
# failing CI, stale PRs, jarvis-labelled issues, npm audit high/critical.
HEALTH_LOOP_ENABLED=false

# Seconds between scans. 600 = 10 min. Lower for active dev, higher for nights.
HEALTH_CHECK_INTERVAL_SECONDS=600

# ───────────────────────────────────────────────────────────────────────────────
# VPS auto-deploy (Claudia wildcard subdomain pipeline)
# ───────────────────────────────────────────────────────────────────────────────

# Enables auto-deploy after each successful web-project task. The built dist/
# folder is rsync'd to DEPLOY_HOST:DEPLOY_BASE_PATH/<repo>/ and served at
# https://<repo>.<DEPLOY_DOMAIN>/ via the existing Traefik + nginx wildcard.
DEPLOY_ENABLED=true
DEPLOY_HOST=root@168.231.78.207
DEPLOY_BASE_PATH=/var/www/cdv-sites
DEPLOY_DOMAIN=codedvisiondesign.co.uk

# ───────────────────────────────────────────────────────────────────────────────
# Hive mind (multi-host worker identity)
# ───────────────────────────────────────────────────────────────────────────────

# Unique identifier for this worker. Defaults to container hostname.
# Recommended: "<host>-<role>" e.g. "djohn-pc-gpu", "kvm2-uk-1", "mbp-djohn".
AGENT_ID=

# Comma-separated capability tags to ADD on top of auto-detected ones.
# Auto-detected: gpu, claude, qwen, hermes, codex, deploy, mobile-dev.
# Leave blank to use auto-detection only.
AGENT_CAPABILITIES=

# How many tasks this worker can run concurrently. Default 1.
# Bump on hosts with spare CPU + multiple Anthropic accounts (rare).
AGENT_MAX_CONCURRENT=1

# ───────────────────────────────────────────────────────────────────────────────
# Local dev stack (PHP / MariaDB / Redis defaults)
# ───────────────────────────────────────────────────────────────────────────────

DB_ROOT_PASSWORD=jarvis_root
DB_NAME=jarvis_dev
DB_USER=jarvis
DB_PASSWORD=jarvis_dev
