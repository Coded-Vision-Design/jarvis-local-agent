# Copy to .env (gitignored) and fill in real values. docker-compose reads .env automatically.

# Where to fetch + write back delegated tasks. Public Jarvis URL.
JARVIS_BASE=https://jarvis.codedvisiondesign.co.uk

# Bearer token Jarvis accepts for the narrow scope: tasks where
# metadata.delegated_to = "local-code-agent". Generate fresh and paste the same
# value into the Jarvis repo .env (`JARVIS_LOCAL_AGENT_TOKEN`) so both sides match.
JARVIS_LOCAL_AGENT_TOKEN=

# Anthropic API key for Claude Code headless when backend=claude.
ANTHROPIC_API_KEY=

# Local Qwen3-Coder served by vLLM on the Windows host. Port 18000 (not vLLM's
# default 8000) keeps us clear of common dev-server conflicts.
VLLM_BASE=http://host.docker.internal:18000
VLLM_MODEL=Qwen/Qwen3-Coder-14B-Instruct

# Webhook URL for posting completion summaries as "Jarvis" into #📋-jarvis-tasks.
# Same value as DISCORD_JARVIS_TASKS_WEBHOOK_URL in the Jarvis repo .env.
DISCORD_JARVIS_TASKS_WEBHOOK_URL=

# Polling cadence.
POLL_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=30
